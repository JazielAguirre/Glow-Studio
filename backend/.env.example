# Server
PORT=3010

# PostgreSQL
# Standard default is 5432. If your PostgreSQL runs on a different port
# (e.g. 5433), update DB_PORT to match your local setup.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=glow_studio
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d
